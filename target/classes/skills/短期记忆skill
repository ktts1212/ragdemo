## 15. ChatServiceImpl 主链路伪代码

完整短期记忆 RAG 链路：

```java
public ChatResponseDto chat(ChatRequestDto request) {

    validateRequest(request);

    String modelKey = resolveModelKey(request.getModel());

    Long knowledgeBaseId = resolveKnowledgeBaseId(request.getKnowledgeBaseId());

    String conversationId =
            memoryService.resolveConversationId(
                    request.getConversationId(),
                    knowledgeBaseId,
                    modelKey
            );

    ConversationMemory memory =
            memoryService.loadMemory(conversationId);

    String rewrittenQuestion =
            queryRewriteService.rewrite(
                    memory,
                    request.getQuestion(),
                    modelKey
            );

    float[] queryVector =
            embeddingModel.embed(rewrittenQuestion).content().vector();

    String pgVector =
            toPgVectorString(queryVector);

    List<RetrievedChunkDto> chunks =
            documentChunkMapper.searchSimilarChunks(
                    knowledgeBaseId,
                    pgVector,
                    topK
            );

    List<RetrievedChunkDto> filteredChunks =
            chunks.stream()
                    .filter(chunk -> chunk.getScore() >= minScore)
                    .toList();

    String context =
            buildContext(filteredChunks);

    String ragPrompt =
            buildPrompt(
                    request.getQuestion(),
                    rewrittenQuestion,
                    context
            );

    String systemPrompt =
            loadSystemPrompt();

    List<ChatMessage> messages =
            memoryAssembler.buildMessages(
                    systemPrompt,
                    memory,
                    ragPrompt
            );

    ChatRequest chatRequest =
            ChatRequest.builder()
                    .messages(messages)
                    .build();

    ChatModel chatModel =
            chatModelFactory.getModel(modelKey);

    ChatResponse response =
            chatModel.chat(chatRequest);

    String answer =
            response.aiMessage().text();

    memoryService.saveTurn(
            conversationId,
            request.getQuestion(),
            answer
    );

    memoryService.updateMemoryAfterTurn(
            conversationId,
            request.getQuestion(),
            answer
    );

    return ChatResponseDto.builder()
            .conversationId(conversationId)
            .answer(answer)
            .rewrittenQuestion(rewrittenQuestion)
            .sources(toSources(filteredChunks))
            .build();
}
```

